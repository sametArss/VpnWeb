@model EntityLayer.Concrete.UserVpn
@using EntityLayer.Concrete

@{
    Layout = null;
    ViewData["Title"] = "VPN Status";

    // Protokol adı ve ikon
    string protoName = Model != null ? Model.Protocol.ToString() : "";
    string protoIcon = (Model != null && Model.Protocol == VpnProtocol.OpenVPN)
        ? "fa-globe"
        : "fa-network-wired";
    string protoBadgeClass = (Model != null && Model.Protocol == VpnProtocol.OpenVPN)
        ? "proto-badge-ovpn"
        : "proto-badge-wg";


    // ConnectedAt DB'de UTC olarak kaydedildi, Türkiye saatine çeviriyoruz (UTC+3)
    var turkeyZone = TimeZoneInfo.FindSystemTimeZoneById(
        System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows)
            ? "Turkey Standard Time"
            : "Europe/Istanbul"
    );
    DateTime connectedAtTr = Model != null && Model.IsActive
        ? TimeZoneInfo.ConvertTimeFromUtc(Model.ConnectedAt, turkeyZone)
        : DateTime.MinValue;
    DateTime nowTr = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, turkeyZone);

    double initialSeconds = 0;
    if (Model != null && Model.IsActive)
    {
        initialSeconds = (nowTr - connectedAtTr).TotalSeconds;
        if (initialSeconds < 0) initialSeconds = 0;
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GlobalShield</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/css/status.css" rel="stylesheet" />
    <style>
        /* ── Protokol Badge ── */
        .proto-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.4px;
        }

        .proto-badge-wg {
            background: rgba(59, 130, 246, 0.15);
            border: 1.5px solid rgba(59, 130, 246, 0.4);
            color: #93c5fd;
        }

        .proto-badge-ovpn {
            background: rgba(245, 158, 11, 0.15);
            border: 1.5px solid rgba(245, 158, 11, 0.4);
            color: #fcd34d;
        }

        /* ── Bağlanma zamanı satırı ── */
        .connected-time-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.83rem;
            color: #64748b;
            margin-top: 4px;
        }

        .connected-time-row i {
            color: #475569;
        }

        /* ── Info row içindeki proto satırı ── */
        .info-row .proto-inline {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Download butonu — loading tetikleme */
        .btn-download {
            position: relative;
        }
    </style>
</head>

<body>
    <a asp-action="Index" class="back-link">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Servers
    </a>

    <div class="status-container">
        <div class="status-card">
            <div class="status-header">
                <h1><i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i> VPN Status</h1>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-3"
                        style="background: rgba(74, 222, 128, 0.1); border-color: rgba(74, 222, 128, 0.2); color: #4ade80; margin-bottom: 1.5rem; margin-top: 1rem;">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                        <div>
                            <strong>Başarılı!</strong>
                            <br />
                            @TempData["Success"]
                        </div>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-3"
                        style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: #f87171; margin-bottom: 1.5rem; margin-top: 1rem;">
                        <i class="fa-solid fa-triangle-exclamation fa-lg"></i>
                        <div>
                            <strong>Hata!</strong>
                            <br />
                            @TempData["Error"]
                        </div>
                    </div>
                }

                @if (Model != null && Model.IsActive)
                {
                    <div class="status-badge active">
                        <span class="status-icon"></span>
                        Connected &amp; Secure
                    </div>
                }
                else
                {
                    <div class="status-badge inactive">
                        <span class="status-icon"></span>
                        Disconnected
                    </div>
                }
            </div>

            @if (Model != null && Model.IsActive)
            {
                <!-- ── Bağlantı Bilgileri ── -->
                <div class="info-section">

                    <!-- IP Adresi -->
                    <div class="info-row">
                        <span class="info-label">
                            <i class="fa-solid fa-network-wired"></i>
                            Your IP Address
                        </span>
                        <span class="info-value">@Model.ClientIp</span>
                    </div>

                    <!-- Şifreleme -->
                    <div class="info-row">
                        <span class="info-label">
                            <i class="fa-solid fa-lock"></i>
                            Connection Status
                        </span>
                        <span class="info-value">Encrypted</span>
                    </div>

                    <!-- Protokol — dinamik -->
                    <div class="info-row">
                        <span class="info-label">
                            <i class="fa-solid fa-bolt"></i>
                            Protocol
                        </span>
                        <span class="info-value proto-inline">
                            <span class="proto-badge @protoBadgeClass">
                                <i class="fa-solid @protoIcon"></i>
                                @protoName
                            </span>
                        </span>
                    </div>

                    <!-- Bağlanma Zamanı -->
                    <div class="info-row">
                        <span class="info-label">
                            <i class="fa-solid fa-clock"></i>
                            Connected At
                        </span>
                        <span class="info-value">
                            @connectedAtTr.ToString("dd MMM yyyy  HH:mm:ss") <small style="color:#64748b;">(TR)</small>
                            <span id="elapsedTimer" style="margin-left:10px; font-size:0.8rem; color:#64748b;"></span>
                        </span>
                    </div>

                </div>

                <!-- ── QR Kod (sadece WireGuard) ── -->
                @if (ViewBag.QrCodeImage != null)
                {
                    <div class="qr-section">
                        <h3><i class="fa-solid fa-mobile-screen-button"></i> Mobile Connection</h3>
                        <p>Scan this QR code with the WireGuard app on your mobile device</p>
                        <div class="qr-code-wrapper">
                            <img src="@ViewBag.QrCodeImage" alt="WireGuard QR Code" />
                        </div>
                    </div>
                }

                <!-- ── Eylem Butonları ── -->
                <div class="action-buttons">
                    <!--
                        Download Config: data-navigate="false" sayesinde loading overlay AÇILMAZ.
                        Tarayıcı dosyayı arka planda indirir, sayfa değişmez.
                    -->
                    <a asp-action="DownloadConfig"
                       class="btn btn-primary btn-download"
                       data-navigate="false"
                       id="downloadConfigBtn">
                        <i class="fa-solid fa-download"></i>
                        Download Config
                    </a>

                    <form asp-action="Disconnect" method="post" style="display:inline;" class="nav-form">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-power-off"></i>
                            Disconnect
                        </button>
                    </form>
                </div>

                <!-- ── Config Metni ── -->
                <div class="config-section">
                    <button class="collapse-btn" onclick="toggleConfig()">
                        <i class="fa-solid fa-file-code"></i>
                        <span id="toggleText">Show Configuration</span>
                    </button>
                    <div class="config-content" id="configContent">
                        <div class="config-text">@Model.ClientConfig</div>
                    </div>
                </div>
            }
            else
            {
                <div class="no-connection">
                    <i class="fa-solid fa-plug-circle-xmark icon"></i>
                    <h2>No Active Connection</h2>
                    <p>You are not currently connected to any VPN server.</p>
                    <a asp-action="Index" class="btn btn-success nav-link-overlay">
                        <i class="fa-solid fa-server"></i>
                        Browse Servers
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.95); z-index: 9999;
            justify-content: center; align-items: center; flex-direction: column; gap: 2rem;">
        <div style="text-align: center;">
            <i class="fa-solid fa-shield-halved"
                style="font-size: 4rem; color: #3b82f6; margin-bottom: 1rem; animation: pulse 1.5s ease-in-out infinite;"></i>
            <div class="spinner-border text-primary" role="status"
                style="width: 60px; height: 60px; border-width: 4px;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p style="color: rgba(255, 255, 255, 0.6); margin-top: 1.5rem; font-size: 0.95rem;">Processing...</p>
        </div>
    </div>
    <link href="~/css/overloading.css" rel="stylesheet" />

    <script>
        /* ── Config toggle ── */
        function toggleConfig() {
            const content = document.getElementById('configContent');
            const text = document.getElementById('toggleText');
            if (!content || !text) return;

            content.classList.toggle('show');
            text.textContent = content.classList.contains('show')
                ? 'Hide Configuration'
                : 'Show Configuration';
        }

        /* ── Loading Overlay ── */
        function showOverlay() {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.style.display = 'flex';
        }

        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', showOverlay);
        });

        document.querySelectorAll('a[href], a[asp-action]').forEach(function (link) {
            if (link.dataset.navigate === 'false') return;
            var href = link.getAttribute('href') || '';
            if (!href || href.startsWith('#')) return;
            link.addEventListener('click', showOverlay);
        });

        /* ── Geçen Süre Sayacı ── */
           @if (Model != null && Model.IsActive)
        {
                @: (function() {
                @:     // Sunucudan gelen başlangıç saniyesi
                @:     var totalSeconds = Math.floor(@initialSeconds);
                @:
                @:     function updateElapsed() {
                @:         totalSeconds++; // Her saniye bir artır
                @:
                @:         var h = Math.floor(totalSeconds / 3600);
                @:         var m = Math.floor((totalSeconds % 3600) / 60);
                @:         var s = totalSeconds % 60;
                @:
                @:         // 'n < 10' hatasından kaçınmak için padStart kullanıyoruz
                @:         var pad = function(n) { return n.toString().padStart(2, '0'); };
                @:
                @:         var timerElem = document.getElementById('elapsedTimer');
                @:         if (timerElem) {
                @:             timerElem.textContent = '(' + pad(h) + ':' + pad(m) + ':' + pad(s) + ' geçti)';
                @:         }
                @:     }
                @:
                @:     // İlk çalıştır ve her saniye güncelle
                @:     updateElapsed();
                @:     setInterval(updateElapsed, 1000);
                @: })();
        }
    </script>

</body>

</html>