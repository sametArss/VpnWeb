@model List<EntityLayer.Concrete.VpnServer>
@using EntityLayer.Concrete @{
    Layout = null;
    ViewData["Title"] = "Server Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GlobalShield</title>
    <!-- Modern Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <style>
        /* ── Protokol Seçici ── */
        .protocol-selector {
            display: flex;
            gap: 10px;
            margin: 16px 0;
        }

        .protocol-option {
            flex: 1;
            position: relative;
        }

        .protocol-option input[type="radio"] {
            display: none;
        }

        .protocol-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 6px;
            border-radius: 10px;
            border: 1.5px solid rgba(255,255,255,0.12);
            background: rgba(255,255,255,0.04);
            color: #94a3b8;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            user-select: none;
        }

        .protocol-label .proto-icon {
            font-size: 1rem;
        }

        /* WireGuard seçilince */
        .protocol-option input[value="WireGuard"]:checked ~ .protocol-label {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            box-shadow: 0 0 14px rgba(59,130,246,0.25);
        }

        /* OpenVPN seçilince */
        .protocol-option input[value="OpenVPN"]:checked ~ .protocol-label {
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.15);
            color: #fcd34d;
            box-shadow: 0 0 14px rgba(245,158,11,0.25);
        }

        .protocol-label:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.08);
            color: #e2e8f0;
        }

        /* ── Bağlan Butonu ── */
        .connect-main-btn {
            width: 100%;
            padding: 13px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #0ea5e9, #3b82f6);
            color: #fff;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            letter-spacing: 0.3px;
            text-decoration: none;
        }

        .connect-main-btn:hover {
            background: linear-gradient(135deg, #0284c7, #2563eb);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(59,130,246,0.45);
        }

        .connect-main-btn:disabled,
        .connect-main-btn.disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* ── Kart büyütme overrides ── */
        .server-card {
            padding: 2rem 1.75rem !important;
            border-radius: 20px !important;
        }

        .server-grid {
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)) !important;
            gap: 2rem !important;
        }

        .card-icon {
            width: 58px !important;
            height: 58px !important;
            font-size: 1.7rem !important;
            border-radius: 14px !important;
            margin-bottom: 1.25rem !important;
        }

        .server-info h3 {
            font-size: 1.4rem !important;
        }

        .server-info p {
            font-size: 0.95rem !important;
        }

        .server-stats {
            font-size: 0.9rem !important;
            margin: 1.2rem 0 !important;
        }

        /* Divider */
        .proto-divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,0.07);
            margin: 0.5rem 0 0;
        }

        .proto-title {
            font-size: 0.78rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark"
         style="background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="fa-solid fa-shield-halved text-primary" style="font-size: 1.5rem;"></i>
                <span class="fw-bold">GlobalShield</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="VpnServer" asp-action="Index">
                            <i class="fa-solid fa-server me-2"></i>Servers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa-solid fa-gear me-2"></i>Settings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Connect" asp-action="Status">
                            <i class="fa-solid fa-wifi me-2"></i>Status
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Profile">
                            <i class="fa-solid fa-user me-2"></i>Account
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container dashboard-container">
        <div class="dashboard-header">
            <div class="header-title">
                <h2><i class="fa-solid fa-earth-americas text-primary me-2"></i> Select Location</h2>
                <p>Choose a secure server node and your preferred protocol.</p>
            </div>
            <div class="status-badge">
                <div class="pulse-dot"></div>
                Protected
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-3"
                 style="background: rgba(74, 222, 128, 0.1); border-color: rgba(74, 222, 128, 0.2); color: #4ade80; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-circle-check fa-lg"></i>
                <div>
                    <strong>Başarılı!</strong>
                    <br />
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-3"
                 style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: #f87171; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-triangle-exclamation fa-lg"></i>
                <div>
                    <strong>Hata!</strong>
                    <br />
                    @TempData["Error"]
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-warning d-flex align-items-center gap-3"
                 style="background: rgba(234, 179, 8, 0.1); border-color: rgba(234, 179, 8, 0.2); color: #fbbf24;">
                <i class="fa-solid fa-triangle-exclamation fa-lg"></i>
                <div>
                    <strong>No Servers Available</strong>
                    <br />
                    There are currently no active VPN nodes. Please check back later.
                </div>
            </div>
        }
        else
        {
            <div class="server-grid">
                @foreach (var vpn in Model)
                {
                    var cardId = $"card_{vpn.Id}";
                    <div class="server-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="card-icon">
                                <i class="fa-solid fa-flag-usa"></i>
                            </div>
                            @if (vpn.IsActive)
                            {
                                <i class="fa-solid fa-circle status-online" title="Online" style="color: #4ade80;"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle status-offline" title="Offline" style="color: #ef4444;"></i>
                            }
                        </div>

                        <div class="server-info">
                            <h3>@vpn.Country</h3>
                            <p>@vpn.Name</p>
                        </div>

                        <div class="server-stats">
                            <div class="stat-item" title="Latency">
                                <i class="fa-solid fa-bolt"></i>
                                <span>@(vpn.LatencyMs.HasValue ? $"{vpn.LatencyMs} ms" : "-- ms")</span>
                            </div>
                            <div class="stat-item" title="Load">
                                <i class="fa-solid fa-users"></i>
                                <span>@(vpn.LoadPercent.HasValue ? $"{vpn.LoadPercent}%" : "-- %")</span>
                            </div>
                        </div>

                        <hr class="proto-divider" />

                        <!-- Protokol Seçimi -->
                        <p class="proto-title mt-3">Protokol Seç</p>
                        <div class="protocol-selector">
                            <div class="protocol-option">
                                <input type="radio" name="protocol_@vpn.Id" value="WireGuard"
                                       id="wg_@vpn.Id" checked>
                                <label class="protocol-label" for="wg_@vpn.Id">
                                    <i class="fa-solid fa-network-wired proto-icon"></i>
                                    WireGuard
                                </label>
                            </div>
                            <div class="protocol-option">
                                <input type="radio" name="protocol_@vpn.Id" value="OpenVPN"
                                       id="ovpn_@vpn.Id">
                                <label class="protocol-label" for="ovpn_@vpn.Id">
                                    <i class="fa-solid fa-globe proto-icon"></i>
                                    OpenVPN
                                </label>
                            </div>
                        </div>

                        <!-- Bağlan Butonu -->
                        <a id="connectBtn_@vpn.Id"
                           href="/Connect/Connect?id=@vpn.Id&protocol=WireGuard"
                           class="connect-main-btn @(!vpn.IsActive ? "disabled" : "")"
                           onclick="if(this.classList.contains('disabled')){return false;} showLoading();">
                            <i class="fa-solid fa-bolt"></i>
                            Bağlan
                        </a>

                        @if (!vpn.IsActive)
                        {
                            <p style="text-align:center; font-size:0.78rem; color:#ef4444; margin-top:8px; margin-bottom:0;">
                                <i class="fa-solid fa-circle-xmark me-1"></i>Bu sunucu şu an çevrimdışı
                            </p>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.95); z-index: 9999;
            justify-content: center; align-items: center; flex-direction: column; gap: 2rem;">
        <div style="text-align: center;">
            <i class="fa-solid fa-shield-halved"
               style="font-size: 4rem; color: #3b82f6; margin-bottom: 1rem; animation: pulse 1.5s ease-in-out infinite;"></i>
            <div class="spinner-border text-primary" role="status"
                 style="width: 60px; height: 60px; border-width: 4px;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p style="color: rgba(255, 255, 255, 0.6); margin-top: 1.5rem; font-size: 0.95rem;">Connecting to VPN...</p>
        </div>
    </div>
    <link href="~/css/overloading.css" rel="stylesheet" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showLoading() {
            document.getElementById('loadingOverlay').style.display = 'flex';
        }

        // Protokol seçimi değiştikçe Bağlan butonunun URL'ini güncelle
        document.querySelectorAll('input[type="radio"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                // name="protocol_ID" → ID'yi al
                var parts = this.name.split('_');
                var serverId = parts[parts.length - 1];
                var protocol = this.value;
                var btn = document.getElementById('connectBtn_' + serverId);
                if (btn) {
                    btn.href = '/Connect/Connect?id=' + serverId + '&protocol=' + protocol;
                }
            });
        });
    </script>

</body>

</html>